FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ARG NEXT_PUBLIC_USER_SERVICE_URL=/user
ARG NEXT_PUBLIC_CHAT_SERVICE_URL=/chat
ENV NEXT_PUBLIC_USER_SERVICE_URL=$NEXT_PUBLIC_USER_SERVICE_URL
ENV NEXT_PUBLIC_CHAT_SERVICE_URL=$NEXT_PUBLIC_CHAT_SERVICE_URL

RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
