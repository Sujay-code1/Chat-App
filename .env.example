# Copy this file to .env and replace the values before deployment.
JWT_SECRET=change_this_to_a_long_secure_secret
RABBITMQ_USERNAME=mingle
RABBITMQ_PASSWORD=change_this_to_a_rabbitmq_password

# Frontend public URLs used by the browser
NEXT_PUBLIC_USER_SERVICE_URL=/user
NEXT_PUBLIC_CHAT_SERVICE_URL=/chat
CLIENT_URL=http://<EC2_PUBLIC_DNS>

# Container service URLs
USER_SERVICE_URL=http://user-service:5000
CHAT_SERVICE_URL=http://chat-service:5002

# Internal infrastructure
MONGO_URI=mongodb://mongo:27017/mingle
REDIS_URL=redis://redis:6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Mail worker SMTP configuration (required to deliver OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Chat App <your-smtp-user>
